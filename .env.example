# Supabase Configuration — Copy this to .env.local and fill in your values
# Get these from: Supabase Console > Project Settings > API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Facebook Pixel ID (optional, leave blank to disable tracking in local development)
VITE_FACEBOOK_PIXEL_ID=

# Neon Serverless PostgreSQL Configuration
# Get your connection string from: https://console.neon.tech > Dashboard > Connection Details
NEON_DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require
VITE_NEON_DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require

# Authentication & Admin Configuration (JWT Secret must be >= 32 characters)
JWT_SECRET=your-secure-32-char-min-jwt-secret-here
ADMIN_EMAIL=admin@lconq.ma
ADMIN_PASSWORD=your-secure-admin-password


